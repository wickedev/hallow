{
  "name": "@hallow/plugin",
  "version": "0.1.0",
  "description": "Universal proto file plugin for Vite, Webpack, ESBuild, and Rollup - enables seamless .proto imports",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "rollup -c && cp src/proto.d.ts dist/proto.d.ts && cp src/parser.d.ts dist/parser.d.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hallow/generator": "*",
    "@hallow/parser": "*",
    "chalk": "^4.1.2",
    "fast-glob": "^3.3.2",
    "minimatch": "^10.1.1",
    "unplugin": "^1.5.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.8.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "esbuild": "^0.19.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "rollup": "^3.29.4",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2",
    "vite": "^4.5.0",
    "webpack": "^5.89.0"
  },
  "peerDependencies": {
    "@hallow/react": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "@hallow/react": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@hallow)/)"
    ],
    "moduleNameMapper": {
      "^@hallow/plugin/(.*)$": "<rootDir>/src/$1"
    }
  }
}
