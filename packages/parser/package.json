{
  "name": "@hallow/parser",
  "version": "0.1.0",
  "description": "Protobuf parser for Hallow gRPC using ANTLR4TS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "yarn clean && yarn generate",
    "build": "rollup -c",
    "clean": "rm -rf dist src/generated",
    "generate": "antlr4ts -visitor -o src/generated grammar/*.g4",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "antlr4ts": "^0.5.0-alpha.4",
    "tslib": "^2.6.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "antlr4ts-cli": "^0.5.0-alpha.4",
    "jest": "^29.5.0",
    "rollup": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-morph": "^19.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/generated/**"
    ]
  }
}
