# Example Environment Configuration
# Copy this file to .env for development or .env.production for production builds

# =============================================================================
# Server Configuration
# =============================================================================

# Host address for the gRPC server to bind to
# - Use 0.0.0.0 to accept connections from any network interface
# - Use 127.0.0.1 or localhost for local-only connections
GRPC_SERVER_HOST=0.0.0.0

# Port number for the gRPC server
# - Default: 3000
# - Must be available and not in use by another service
# - Common alternatives: 8080, 50051 (gRPC default)
GRPC_SERVER_PORT=3000

# =============================================================================
# Client Configuration
# =============================================================================

# URL of the gRPC server for the client to connect to
# - Development: http://localhost:3000
# - Production: Your production server URL (e.g., https://api.example.com)
# - Must match the server's host and port
GRPC_SERVER_URL=http://localhost:3000

# =============================================================================
# Application Configuration
# =============================================================================

# Node environment
# - development: Enables debug features, verbose logging
# - production: Optimized builds, minimal logging
# - test: Testing environment
NODE_ENV=development

# =============================================================================
# Optional Advanced Configuration
# =============================================================================

# Webpack Dev Server Port (optional, defaults to 8080)
# WDS_PORT=8080

# Webpack Dev Server Host (optional, defaults to localhost)
# WDS_HOST=localhost

# Enable React DevTools (optional, defaults to true in development)
# REACT_DEVTOOLS=true

# Enable source maps in production (optional, defaults to false)
# GENERATE_SOURCEMAP=false
