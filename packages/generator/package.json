{
  "name": "@hallow/generator",
  "version": "0.1.0",
  "description": "Code generator for Hallow gRPC - generates TypeScript code from parsed proto AST",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rollup -c",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hallow/parser": "*",
    "google-protobuf": "^3.21.2",
    "@improbable-eng/grpc-web": "^0.15.0",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/google-protobuf": "^3.15.6",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.8.0",
    "jest": "^29.7.0",
    "rollup": "^3.29.4",
    "ts-jest": "^29.1.1",
    "ts-morph": "^20.0.0",
    "typescript": "^5.2.2"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(@hallow)/)"
    ],
    "moduleNameMapper": {
      "^@hallow/generator/(.*)$": "<rootDir>/src/$1"
    }
  }
}