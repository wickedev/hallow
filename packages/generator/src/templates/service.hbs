 */
export interface MethodDescriptor<TRequest, TResponse> {
  /**
   * Method name (e.g., "GetUser")
   */
  readonly methodName: string;

  /**
   * Fully qualified service name (e.g., "test.services.UserService")
   */
  readonly serviceName: string;

  /**
   * Request type name
   */
  readonly requestType: string;

  /**
   * Response type name
   */
  readonly responseType: string;

  /**
   * Whether this is a client streaming RPC
   */
  readonly requestStream: boolean;

  /**
   * Whether this is a server streaming RPC
   */
  readonly responseStream: boolean;
}

/**
 * Cancellation token for streaming operations
 */
export interface CancellationToken {
  cancel(): void;
  readonly isCancelled: boolean;
  onCancel(callback: () => void): void;
}

/**
 * Implementation of cancellation token
 */
class CancellationTokenImpl implements CancellationToken {
  private _isCancelled = false;
  private readonly cancelCallbacks: Array<() => void> = [];
  
  get isCancelled(): boolean {
    return this._isCancelled;
  }
  
  cancel(): void {
    if (this._isCancelled) return;
    this._isCancelled = true;
    this.cancelCallbacks.forEach(callback => callback());
  }
  
  onCancel(callback: () => void): void {
    if (this._isCancelled) {
      callback();
    } else {
      this.cancelCallbacks.push(callback);
    }
  }
}

